# PhotoPrism MCP Server Configuration

# PhotoPrism Connection
PHOTOPRISM_URL=http://localhost:2342
PHOTOPRISM_USERNAME=admin
PHOTOPRISM_PASSWORD=your-secure-password-here

# Transport Mode
# Options: stdio (default), http, tcp, websocket
TRANSPORT=stdio

# Logging
RUST_LOG=info

# Build Information (for docker-compose)
VERSION=dev
BUILDTIME=now
REVISION=local
